# Compose port knobs for the containerized stack. Copy to `.env` to override:
#
#   cp .env.example .env
#
# `.env` is OPTIONAL — the defaults below work with no `.env` file at all.
# `docker compose` reads `.env` automatically.
#
# This file is ONLY for `docker compose` (the one-command stack). It is NOT the
# same as `frontend/.env.local.example`, which feeds the two-terminal local flow.

# Host port the API is published on. The browser reaches the API here, so
# NEXT_PUBLIC_API_BASE_URL is derived from this in docker-compose.yml.
# NOTE: changing this needs `docker compose up --build` — the value is baked
# into the frontend bundle at build time.
API_PORT=3000

# Host port the frontend is published on. FRONTEND_ORIGIN (the CORS origin the
# API allows) is derived from this in docker-compose.yml.
FRONTEND_PORT=3001

# Do NOT set FRONTEND_ORIGIN or NEXT_PUBLIC_API_BASE_URL here — compose computes
# them from the two ports above so they can never drift out of sync.
